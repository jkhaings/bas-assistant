# The public entry point. DNS is a Route 53 A record with no proxy in front, so Caddy obtains
# and renews the Let's Encrypt certificate for {$DOMAIN} itself.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Prometheus scrapes the app on the compose network; the raw counters stay off the link.
	handle /metrics* {
		respond 404
	}

	# Grafana serves from the /grafana sub-path itself, so the prefix is passed through.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# The API and the web app. Caddy flushes text/event-stream responses as they arrive.
	handle {
		reverse_proxy app:8000
	}
}
